{
  "name": "blocklist.sefinek.net",
  "version": "0.24.1-rc.2+20261026",
  "private": true,
  "homepage": "https://blocklist.sefinek.net",
  "bugs": {
    "url": "https://github.com/sefinek/Sefinek-Blocklist-Collection/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sefinek/Sefinek-Blocklist-Collection.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Sefinek <contact@sefinek.net> (https://sefinek.net)",
  "type": "commonjs",
  "main": "www/index.js",
  "scripts": {
    "m": "ncu -u && npm i && npm update && npm audit fix",
    "pull": "git pull origin main",
    "pull:blocklists": "git -C blocklists fetch origin +refs/heads/blocklists:refs/remotes/origin/blocklists && git -C blocklists reset --hard origin/blocklists",
    "pullsh": "bash bash/pull.sh",
    "test": "node scripts/test-urls.js",
    "update": "npm run pull && npm run pull:blocklists && npm ci --omit=dev && pm2 restart blocklist && node scripts/purge-cloudflare-cache.js",
    "cf:logs": "cd cloudflare && wrangler tail sefinek-blocklist-edge-cache",
    "cf:deploy": "cd cloudflare && wrangler deploy"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cron-parser": "^5.10.2",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-timeout-handler": "^2.2.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "lzma-native": "^8.0.6",
    "marked": "^18.1.1",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "ipaddr.js": "^2.5.0",
    "kleur": "^4.1.5",
    "unzipper": "^0.12.5",
    "validator": "^13.15.35"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "lzma-native@8.0.6": true
  }
}
