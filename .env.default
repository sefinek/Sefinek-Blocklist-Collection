# ------------  Main  ------------
# development or production
NODE_ENV=development

# ------------ Server ------------
DOMAIN=http://127.0.0.1
PORT=8080
WS_ADDRESS=ws://127.0.0.1
WS_PORT=8095

# ----------- MongoDB -----------
MONGODB_URL=mongodb://127.0.0.1:27017/blocklist

# ----------- Mail -----------
MAILER_HOST=
MAILER_PORT=
MAILER_AUTH_USER=
MAILER_AUTH_PASSWD=""

# -----------  Redis  -----------
REDIS_HOST=
REDIS_PASSWD=

# --------- Cloudflare (edge cache for /generated/v1/*) ---------
EDGE_STATS_SECRET=
# CLOUDFLARE_API_TOKEN needs 3 policies: Zone/Cache Purge/Purge, Zone/Analytics/Read, Zone/Workers Routes/Edit
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=